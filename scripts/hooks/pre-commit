#!/bin/bash
# Refuses commits not made with the GitHub no-reply identity, then runs the privacy scan.
NOREPLY="162063181+pradyuns@users.noreply.github.com"
for email in "$(git config user.email)" "${GIT_AUTHOR_EMAIL:-$NOREPLY}" "${GIT_COMMITTER_EMAIL:-$NOREPLY}"; do
  if [ "$email" != "$NOREPLY" ]; then
    echo "BLOCKED: commits must use the GitHub no-reply email ($NOREPLY), got '$email'." >&2
    exit 1
  fi
done
repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
python3 "$repo_root/scripts/precommit_scan.py"
